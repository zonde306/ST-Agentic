              "injectionPosition": "relative",
              "enabled": true,
              "internal": null,
              "injectionDepth": 4,
              "injectionOrder": 100,
              "maxDepth": 999
            }
          ],
          "regex": "",
          "findRegex": "/<scene>([\\s\\S]+?)<\\/scene>/",
          "filters": [],
          "retryCount": 2,
          "retryInterval": 500
        },
        "agent:archivist": {
          "id": "legacy-agent-archivist",
          "kind": "agent",
          "binding": "archivist",
          "tag": "",
          "prompts": [
            {
              "name": "Archivist System",
              "role": "system",
              "triggers": [],
              "prompt": "You are a concise lore archivist.",
              "injectionPosition": "relative",
              "enabled": true,
              "internal": null,
              "injectionDepth": 4,
              "injectionOrder": 100,
              "maxDepth": 999
            }
          ],
          "regex": "",
          "findRegex": "",
          "filters": [],
          "retryCount": 1,
          "retryInterval": 500
        }
      },
      "tools": {
        "read_file": {
          "enabled": true,
          "triggers": [],
          "parameters": {
            "path": "Target file path"
          },
          "description": "Read a file from VFS"
        }
      },
      "files": {
        "style-guide.md": "# 文风参考\n优先使用感官细节描写。"
