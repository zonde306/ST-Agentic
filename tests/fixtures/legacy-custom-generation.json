{
  "apis": {
    "Default": {
      "baseUrl": "https://api.openai.com/v1",
      "apiKey": "sk-legacy-secret-key",
      "model": "gpt-4o",
      "contextSize": 64000,
      "maxTokens": 4096,
      "temperature": 0.8,
      "topK": 40,
      "topP": 0.95,
      "frequencyPenalty": 0.1,
      "presencePenalty": 0,
      "stream": true,
      "includeHeaders": { "X-Custom": "1" },
      "includeBody": {},
      "excludeBody": {},
      "promptPostProcessing": "none",
      "linkedPreset": "LegacyRP",
      "maxConcurrency": 2
    },
    "FastModel": {
      "baseUrl": "https://api.deepseek.com/v1",
      "apiKey": "sk-fast-key",
      "model": "deepseek-chat",
      "contextSize": 32000,
      "maxTokens": 2048,
      "temperature": 0.3,
      "topK": 20,
      "topP": 0.9,
      "frequencyPenalty": 0,
