  "currentApi": "Default",
  "presets": {
    "LegacyRP": {
      "name": "LegacyRP",
      "prompts": [
        {
          "name": "Main Prompt",
          "role": "system",
          "triggers": [],
          "prompt": "",
          "injectionPosition": "relative",
          "enabled": true,
          "internal": "main",
          "injectionDepth": 4,
          "injectionOrder": 100,
          "maxDepth": 999
        },
        {
          "name": "全局文风指导",
          "role": "system",
          "triggers": ["normal", "swipe", "regenerate"],
          "prompt": "保持描写细腻，避免空洞总结。",
          "injectionPosition": "relative",
          "enabled": true,
          "internal": null,
          "injectionDepth": 4,
          "injectionOrder": 100,
          "maxDepth": 999
        },
        {
          "name": "Chat History",
          "role": "system",
          "triggers": [],
          "prompt": "",
          "injectionPosition": "relative",
          "enabled": true,
          "internal": "chatHistory",
          "injectionDepth": 4,
          "injectionOrder": 100,
          "maxDepth": 65535
        },
        {
          "name": "旧版深度3注入",
          "role": "system",
          "triggers": [],
          "prompt": "此深度注入在新架构中应被跳过。",
          "injectionPosition": "inChat",
          "enabled": true,
          "internal": null,
          "injectionDepth": 3,
          "injectionOrder": 100,
          "maxDepth": 999
