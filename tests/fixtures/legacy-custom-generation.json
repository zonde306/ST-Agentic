          "injectionPosition": "inChat",
          "enabled": true,
          "internal": null,
          "injectionDepth": 0,
          "injectionOrder": 100,
          "maxDepth": 999
        }
      ],
      "regexs": [
        {
          "name": "展示层状态栏折叠",
          "regex": "/<status>([\\s\\S]*?)<\\/status>/g",
          "replace": "<details><summary>状态</summary>$1</details>",
          "userInput": false,
          "aiOutput": true,
          "worldInfo": false,
          "enabled": true,
          "minDepth": null,
          "maxDepth": null,
          "ephemerality": true,
          "request": false,
          "response": true
        },
        {
          "name": "世界书注释清洗",
          "regex": "/<!--([\\s\\S]*?)-->/g",
          "replace": "",
          "userInput": false,
          "aiOutput": false,
          "worldInfo": true,
          "enabled": true,
          "minDepth": null,
          "maxDepth": null,
          "ephemerality": false,
          "request": true,
          "response": false
        },
        {
          "name": "入轨冗余标签剥离",
          "regex": "/<debug_note>[\\s\\S]*?<\\/debug_note>/g",
          "replace": "",
          "userInput": false,
          "aiOutput": true,
          "worldInfo": false,
          "enabled": true,
          "minDepth": 1,
          "maxDepth": 10,
          "ephemerality": false,
          "request": true,
          "response": true
        }
      ],
      "templates": {
        "trigger:@@replace:": {
          "id": "legacy-replace",
          "kind": "trigger",
          "binding": "@@replace",
          "tag": "",
          "prompts": [
            {
              "name": "Instruction",
              "role": "user",
              "triggers": [],
              "prompt": "Update the document based on the latest turn.",
              "injectionPosition": "relative",
              "enabled": true,
              "internal": null,
              "injectionDepth": 4,
              "injectionOrder": 100,
              "maxDepth": 999
            }
          ],
          "regex": "/<doc>([\\s\\S]+?)<\\/doc>/i",
          "findRegex": "",
          "filters": ["worldInfoDepth", "authorsNoteDepth"],
          "retryCount": 3,
          "retryInterval": 1000
        },
        "trigger:@@variables_json:stats": {
          "id": "legacy-vars-stats",
          "kind": "trigger",
          "binding": "@@variables_json",
          "tag": "stats",
